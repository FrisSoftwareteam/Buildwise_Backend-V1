MONGODB_URI=mongodb://127.0.0.1:27017/buildwise
MONGODB_DB=buildwise
PORT=4000
WEB_PORT=3000
BASE_PATH=/
PUBLIC_WEB_URL=http://localhost:3000
GEMINI_API_KEY=your_gemini_api_key_here

# Microsoft Entra ID (Azure AD) sign-in
# Create an app registration, add a Web redirect URI of:
#   http://localhost:3000/api/auth/oauth/microsoft/callback
# then paste the client id/secret here. Use "common" for personal + work accounts,
# or your tenant GUID to restrict sign-in to one organization.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/oauth/microsoft/callback

# Optional. If unset, overdue task reminders are logged instead of emailed.
MAIL_FROM=BuildWise <noreply@buildwise.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
